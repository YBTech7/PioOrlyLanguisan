# GEMINI_API_KEY: Required for Gemini AI API calls on the backend server.
# Never expose this key in client-side code or Vite VITE_* variables.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional override for the Gemini model identifier.
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet or backend service is hosted.
APP_URL=""

# ADMIN_PASSCODE: Required on the backend server to authenticate Admin Console requests.
# Leave unset in untrusted environments or provide via secure runtime secrets (min 12 chars).
ADMIN_PASSCODE=""

# ALLOWED_ORIGINS: Comma-separated origins permitted by CORS (e.g. https://ybtech7.github.io).
ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Optional external backend base URL when hosting frontend statically (e.g. GitHub Pages).
VITE_API_BASE_URL=""

# VITE_BASE_PATH: Vite public base path ('/' for root hosting, '/PioOrlyLanguisan/' for GitHub Pages).
VITE_BASE_PATH="/"

# Consultation delivery uses a separate durable database and the Gmail send scope.
CONSULTATION_DATABASE_URL=""
CONSULTATION_EMAIL_TO="pioorly.languisan@gmail.com"
CONSULTATION_EMAIL_FROM=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
